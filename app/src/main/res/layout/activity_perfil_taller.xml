<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F4F4"
    android:orientation="vertical">


    <View
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:background="#07366C" />


    <!-- ENCABEZADO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="20dp"
        android:paddingRight="20dp">


        <TextView
            android:id="@+id/btnVolver"
            android:layout_width="45dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="‹"
            android:textColor="#07366C"
            android:textSize="35sp"
            android:textStyle="bold" />


        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Perfil del taller"
            android:textColor="#111111"
            android:textSize="20sp"
            android:textStyle="bold" />


        <ImageView
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:contentDescription="Logo Gou"
            android:scaleType="centerInside"
            android:src="@mipmap/ic_launcher" />

    </LinearLayout>


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="25dp"
            android:paddingRight="25dp"
            android:paddingBottom="35dp">


            <!-- FOTO -->
            <ImageView
                android:id="@+id/imgTaller"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="10dp"
                android:background="#DDDDDD"
                android:contentDescription="Fotografía del taller"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_taller" />


            <!-- NOMBRE -->
            <TextView
                android:id="@+id/txtNombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Taller"
                android:textColor="#111111"
                android:textSize="23sp"
                android:textStyle="bold" />


            <!-- PROPIETARIO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Propietario"
                android:textColor="#111111"
                android:textSize="14sp"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/txtPropietario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text=""
                android:textColor="#555555"
                android:textSize="14sp" />


            <!-- DESCRIPCIÓN -->
            <TextView
                android:id="@+id/txtDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text=""
                android:textColor="#555555"
                android:textSize="14sp" />


            <!-- SERVICIOS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Servicios"
                android:textColor="#111111"
                android:textSize="18sp"
                android:textStyle="bold" />


            <LinearLayout
                android:id="@+id/contenedorServicios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />


            <!-- HORARIO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Horario de atención"
                android:textColor="#111111"
                android:textSize="18sp"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/txtHorario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text=""
                android:textColor="#555555"
                android:textSize="14sp" />


            <!-- CONTACTO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Teléfono de contacto"
                android:textColor="#111111"
                android:textSize="18sp"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/txtTelefono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text=""
                android:textColor="#555555"
                android:textSize="14sp" />


            <!-- CALIFICACIÓN -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="Calificación y reseñas"
                android:textColor="#111111"
                android:textSize="18sp"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/txtResumenResenas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Este taller aún no tiene reseñas"
                android:textColor="#07366C"
                android:textSize="15sp"
                android:textStyle="bold" />


            <LinearLayout
                android:id="@+id/listaResenas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:orientation="vertical" />


            <Button
                android:id="@+id/btnCalificar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:backgroundTint="#07366C"
                android:text="Calificar taller"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>