<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F4F4"
    android:orientation="vertical">


    <View
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:background="#07366C" />


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="25dp"
            android:paddingTop="30dp"
            android:paddingRight="25dp"
            android:paddingBottom="25dp">


            <!-- Logo / nombre -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gou"
                android:textColor="#07366C"
                android:textSize="20sp"
                android:textStyle="bold" />


            <!-- Saludo -->
            <TextView
                android:id="@+id/txtHola"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="¡Hola!"
                android:textColor="#111111"
                android:textSize="23sp"
                android:textStyle="bold" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Administra tu taller"
                android:textColor="#666666"
                android:textSize="14sp" />


            <!-- MI TALLER -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="35dp"
                android:text="Mi taller"
                android:textColor="#111111"
                android:textSize="18sp"
                android:textStyle="bold" />


            <!-- TARJETA DEL TALLER -->
            <LinearLayout
                android:id="@+id/cardTaller"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="18dp">


                <TextView
                    android:id="@+id/txtTaller"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cargando taller..."
                    android:textColor="#111111"
                    android:textSize="17sp"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/txtServicios"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text=""
                    android:textColor="#07366C"
                    android:textSize="14sp"
                    android:textStyle="bold" />


                <Button
                    android:id="@+id/btnVer"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="18dp"
                    android:backgroundTint="#07366C"
                    android:text="Ver perfil"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />


                <Button
                    android:id="@+id/btnEditar"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#DDDDDD"
                    android:text="Editar información"
                    android:textAllCaps="false"
                    android:textColor="#07366C"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/txtEstado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Estado: Activo"
                    android:textColor="#555555"
                    android:textSize="14sp"
                    android:textStyle="bold" />


                <Button
                    android:id="@+id/btnEstado"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#07366C"
                    android:text="Desactivar taller"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- EXPLORAR OTROS TALLERES -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="25dp"
                android:text="¿Quieres conocer otros talleres?"
                android:textColor="#666666"
                android:textSize="14sp" />


            <TextView
                android:id="@+id/txtVerOtrosTalleres"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:padding="8dp"
                android:text="Ver otros talleres"
                android:textColor="#07366C"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

    </ScrollView>


    <!-- CERRAR SESIÓN -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F4F4F4"
        android:orientation="vertical"
        android:paddingLeft="25dp"
        android:paddingTop="10dp"
        android:paddingRight="25dp"
        android:paddingBottom="18dp">


        <Button
            android:id="@+id/btnSalir"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:backgroundTint="#07366C"
            android:text="Cerrar sesión"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>