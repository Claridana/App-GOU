<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F4F4"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Barra azul superior -->
        <View
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:background="#07366C" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingLeft="30dp"
            android:paddingTop="55dp"
            android:paddingRight="30dp"
            android:paddingBottom="30dp">

            <!-- Logo -->
            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_gravity="center_horizontal"
                android:contentDescription="Logo Gou"
                android:scaleType="centerInside"
                android:src="@mipmap/ic_launcher" />

            <!-- Título -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="25dp"
                android:text="Iniciar sesión"
                android:textColor="#111111"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Subtítulo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="5dp"
                android:text="Bienvenido de nuevo a Gou"
                android:textColor="#555555"
                android:textSize="14sp" />

            <!-- Correo -->
            <EditText
                android:id="@+id/edtCorreo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="45dp"
                android:hint="Correo electrónico"
                android:inputType="textEmailAddress"
                android:singleLine="true"
                android:textColor="#111111"
                android:textColorHint="#666666" />

            <!-- Contraseña -->
            <EditText
                android:id="@+id/edtClave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:hint="Contraseña"
                android:inputType="textPassword"
                android:singleLine="true"
                android:textColor="#111111"
                android:textColorHint="#666666"
                android:drawableEnd="@drawable/ic_visibility"
                android:drawablePadding="10dp"/>

            <!-- Recuperar contraseña -->
            <TextView
                android:id="@+id/txtOlvideClave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="10dp"
                android:padding="6dp"
                android:text="¿Olvidaste tu contraseña?"
                android:textColor="#07366C"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Entrar -->
            <Button
                android:id="@+id/btnEntrar"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#07366C"
                android:text="Iniciar sesión"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <!-- Crear cuenta -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="30dp"
                android:text="¿No tienes una cuenta?"
                android:textColor="#555555"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtCrear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="3dp"
                android:padding="8dp"
                android:text="Crear cuenta como cliente"
                android:textColor="#07366C"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>